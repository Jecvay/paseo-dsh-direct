{
  "owner": "Jecvay",
  "repo": "Jecvay/paseo-dsh-direct",
  "dsh": {
    "0.2": "~/<path-to>/dsh-0.2/bin/dsh",
    "0.1": "~/<path-to>/dsh-0.1/bin/dsh"
  },
  "patch": "~/.config/paseo-dsh-direct/dsh-headless.patch.yml",
  "hidePaths": [
    "~/.config/gh",
    "~/.ssh",
    "~/.git-credentials",
    "~/.npmrc",
    "~/.netrc",
    "~/.docker/config.json"
  ],
  "pollSeconds": 60,
  "dshHome": "~/.local/share/paseo-dsh-direct/dsh-home",
  "credentials": "~/.dsh/.credentials.yaml"
}
